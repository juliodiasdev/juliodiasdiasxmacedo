# Deixe em branco para rodar em modo local (conteúdo lido de /content).
# Preencha para ativar Supabase (banco, autenticação, armazenamento e /admin).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mail autorizado a acessar /admin (verificação extra no servidor, além da tabela `admins`).
ADMIN_EMAIL=

# URL pública do site (metadados / Open Graph). Ex.: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=
